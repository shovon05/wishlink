!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Next.js Build Outputs
/.next/
/out/
/build
*.tsbuildinfo
next-env.d.ts

# Production & Deployment
.vercel
/coverage

# Environment Configuration
